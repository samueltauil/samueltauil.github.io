---
permalink: /sitemap.xml
sitemap: false
---
{%- assign base = site.url -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for post in site.posts -%}
{%- unless post.lang == 'pt-br' %}
  <url>
    <loc>{{ post.url | prepend: base }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  <url>
    <loc>{{ post.url | prepend: '/pt-br' | prepend: base }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endunless -%}
{%- endfor -%}
{%- for page in site.html_pages -%}
{%- unless page.sitemap == false or page.lang == 'pt-br' or page.url contains '404' %}
{%- assign path = page.url | replace: '/index.html', '/' %}
  <url>
    <loc>{{ path | prepend: base }}</loc>
  </url>
  <url>
    <loc>{{ path | prepend: '/pt-br' | prepend: base }}</loc>
  </url>
{%- endunless -%}
{%- endfor %}
</urlset>

